; Gold 3DS vertex shader: position + texcoord + (shade, glow)
; colour = shade * ambient + glow * glowClr   (ambient/glowClr follow the time of day)

.fvec projection[4], modelView[4]
.fvec ambient, glowClr

.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  ones  myconst.yyyy

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos   v0
.alias intex   v1
.alias inlight v2   ; x = baked shade, y = window glow

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex

	mul r2, ambient, inlight.xxxx
	mad r2, inlight.yyyy, glowClr, r2
	min r2, ones, r2
	mov r2.w, ones
	mov outclr, r2
	end
.end
